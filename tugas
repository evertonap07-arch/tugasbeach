function addCustomPastelToCart() {
 const checked = [...document.querySelectorAll('input[name="custom_ing"]:checked')];

 if (checked.length === 0) {
  alert("Selecione pelo menos 1 ingrediente.");
  return;
 }

 if (checked.length > 3) {
  alert("Você pode escolher no máximo 3 ingredientes.");
  return;
 }

