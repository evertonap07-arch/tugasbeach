}

function bindAddButtons() {
 document.querySelectorAll("[data-add]").forEach(button => {
  button.addEventListener("click",() => {
   const id = button.dataset.add;
   cart[id] = (Number(cart[id]) || 0) + 1;
   saveStorage(CART_KEY,cart);
   renderCart();

   const original = button.innerHTML;
   button.innerHTML = "Adicionado ✓";
   button.disabled = true;

   setTimeout(() => {
    button.innerHTML = original;
    button.disabled = false;
   },700);
  });
 });
}

function renderCart() {
 const entries = getCartEntries();
 const count = entries.reduce((sum,[id,quantity]) => sum + Number(quantity),0);
 const rawTotal = getRawTotal();
 const comboDiscount = getComboDiscount();

 if (activeCoupon && rawTotal < activeCoupon.minVal) {
  activeCoupon = null;
  const feedback = document.getElementById("couponFeedback");
  feedback.style.color = "#ff4d5a";
  feedback.textContent = "Cupom removido: o carrinho ficou abaixo do valor mínimo.";
 }

 const couponDiscount = activeCoupon ? activeCoupon.discount : 0;
 const finalTotal = getFinalTotal();

 document.getElementById("cartbar").hidden = count === 0;
 document.getElementById("count").textContent =
  `${count} ${count === 1 ? "item" : "itens"} no carrinho`;

 document.getElementById("barTotal").textContent = money(finalTotal);
 document.getElementById("total").textContent = money(finalTotal);

 document.getElementById("discountBox").innerHTML =
  comboDiscount > 0
  ? `<div class="discount-tag">
      <span>🎉 Desconto de combo (${getPastelCount()} pastéis)</span>
      <span>- ${money(comboDiscount)}</span>
     </div>`
  : getPastelCount() > 0
   ? `<p style="font-size:12px;color:var(--sol);margin:8px 0">
       💡 Adicione mais ${5 - getPastelCount()} pastel(is) para ativar o desconto.
      </p>`
   : "";

 document.getElementById("couponDisplayBox").innerHTML = activeCoupon
  ? `<div class="coupon-tag">
      <span>🎟️ Cupom ${escapeHTML(activeCoupon.code)}</span>
      <span>
       - ${money(activeCoupon.discount)}
       <button type="button" id="removeCoupon" style="background:none;border:0;color:#ff4d5a;font-weight:bold">Remover</button>
      </span>
     </div>`
  : "";

 document.getElementById("cartItems").innerHTML = entries.length
  ? entries.map(([id,quantity]) => {
     const product = getProduct(id);
     const details = product.ingredients || "";
     return `
      <div class="cartline">
       <div>
        <strong>${escapeHTML(product.name)}</strong>
        ${details ? `<small>${escapeHTML(details)}</small>` : ""}
        <small>${money(product.price)} cada · ${money(product.price * quantity)}</small>
       </div>
       <div class="qty">
        <button type="button" data-minus="${escapeHTML(id)}" aria-label="Diminuir">−</button>
        <strong>${quantity}</strong>
        <button type="button" data-plus="${escapeHTML(id)}" aria-label="Aumentar">+</button>
       </div>
      </div>
     `;
    }).join("")
  : "<p>Seu carrinho está vazio.</p>";

 saveStorage(CART_KEY,cart);

 document.querySelectorAll("[data-minus]").forEach(button => {
  button.addEventListener("click",() => {
   const id = button.dataset.minus;
   cart[id] = Number(cart[id]) - 1;
   if (cart[id] <= 0) delete cart[id];
   saveStorage(CART_KEY,cart);
   renderCart();
  });
 });

 document.querySelectorAll("[data-plus]").forEach(button => {
  button.addEventListener("click",() => {
   const id = button.dataset.plus;
   cart[id] = Number(cart[id]) + 1;
   saveStorage(CART_KEY,cart);
   renderCart();
  });
 });

 const removeButton = document.getElementById("removeCoupon");
 if (removeButton) {
  removeButton.addEventListener("click",removeCoupon);
 }
}

function applyCoupon() {
 const code = document.getElementById("couponInput").value.trim().toUpperCase();
 const feedback = document.getElementById("couponFeedback");

 if (!code) {
  feedback.style.color = "#ff4d5a";
  feedback.textContent = "Digite um código de cupom.";
  return;
 }

 if (!getCartEntries().length) {
  feedback.style.color = "#ff4d5a";
  feedback.textContent = "Adicione produtos antes de aplicar um cupom.";
  return;
 }

 const coupons = {
  TUGA2:{code:"TUGA2",discount:2,minVal:20},
  DESCONTO2:{code:"DESCONTO2",discount:2,minVal:20},
  TUGA5:{code:"TUGA5",discount:5,minVal:50},
  DESCONTO5:{code:"DESCONTO5",discount:5,minVal:50},
  TUGA10:{code:"TUGA10",discount:10,minVal:70},
  DESCONTO10:{code:"DESCONTO10",discount:10,minVal:70}
 };

 const coupon = coupons[code];

 if (!coupon) {
  feedback.style.color = "#ff4d5a";
  feedback.textContent = "Cupom inválido ou não reconhecido.";
  return;
 }

 if (getRawTotal() < coupon.minVal) {
  feedback.style.color = "#ff4d5a";
  feedback.textContent = `Este cupom exige compras de pelo menos ${money(coupon.minVal)}.`;
  return;
 }

 activeCoupon = coupon;
 feedback.style.color = "var(--agua)";
 feedback.textContent = `Cupom aplicado! Desconto de ${money(coupon.discount)}.`;

 document.getElementById("couponInput").value = "";
 renderCart();
}

function removeCoupon() {
 activeCoupon = null;
 document.getElementById("couponFeedback").textContent = "Cupom removido.";
 renderCart();
}

