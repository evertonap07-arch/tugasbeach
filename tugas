 "Brócolis","Tomate","Milho","Orégano"
];

const money = value => Number(value).toLocaleString("pt-BR",{
 style:"currency",
 currency:"BRL"
});

function readStorage(key,fallback) {
 try {
  const value = localStorage.getItem(key);
  return value ? JSON.parse(value) : fallback;
 } catch(error) {
  return fallback;
 }
}

function saveStorage(key,value) {
 try {
  localStorage.setItem(key,JSON.stringify(value));
 } catch(error) {
  console.warn("Não foi possível salvar os dados neste aparelho.",error);
 }
}

function escapeHTML(value) {
 return String(value ?? "").replace(/[&<>"']/g,char => ({
  "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
 }[char]));
}

let customProducts = readStorage(CUSTOM_KEY,[]);
if (!Array.isArray(customProducts)) customProducts = [];

const products = MENU.flatMap(category => category.items).concat(customProducts);

let cart = readStorage(CART_KEY,{});
if (!cart || typeof cart !== "object" || Array.isArray(cart)) cart = {};

let activeCoupon = null;

const categoriesElement = document.getElementById("categories");
const menuElement = document.getElementById("menu");

const shellIcon = `
 <svg viewBox="0 0 64 44" aria-hidden="true">
  <use href="#shell"></use>
 </svg>
`;

function getProduct(id) {
 return products.find(product => String(product.id) === String(id));
}

function getCartEntries() {
 return Object.entries(cart).filter(([id,quantity]) =>
  Number(quantity) > 0 && getProduct(id)
 );
}

function getRawTotal() {
 return getCartEntries().reduce((sum,[id,quantity]) => {
  const product = getProduct(id);
  return sum + product.price * Number(quantity);
 },0);
}

function getPastelCount() {
 return getCartEntries().reduce((sum,[id,quantity]) => {
  const product = getProduct(id);
  return sum + (product && !product.isDrink ? Number(quantity) : 0);
 },0);
}

function getComboDiscount() {
 const quantity = getPastelCount();
 if (quantity < 5) return 0;
 return Math.min(5,2 + (quantity - 5) * 0.5);
}

function getFinalTotal() {
 const raw = getRawTotal();
 const combo = getComboDiscount();
 const coupon = activeCoupon ? activeCoupon.discount : 0;
 return Math.max(0,raw - combo - coupon);
}

