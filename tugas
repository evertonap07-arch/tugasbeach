const termsModal = document.getElementById("termsModal");

function openModal(element) {
 element.classList.add("open");
 document.body.classList.add("modal-open");
}

function closeModal(element) {
 element.classList.remove("open");
 if (!document.querySelector(".modal.open")) {
  document.body.classList.remove("modal-open");
 }
}

document.getElementById("openCart").addEventListener("click",() => openModal(modal));
document.getElementById("closeCart").addEventListener("click",() => closeModal(modal));
document.getElementById("closeTrack").addEventListener("click",() => closeModal(trackModal));

document.getElementById("openTrackModal").addEventListener("click",() => {
 renderOrderHistory();
 openModal(trackModal);
});

document.getElementById("applyCouponBtn").addEventListener("click",applyCoupon);

document.getElementById("couponInput").addEventListener("keydown",event => {
 if (event.key === "Enter") {
  event.preventDefault();
  applyCoupon();
 }
});

[modal,trackModal,privacyModal,termsModal].forEach(element => {
 element.addEventListener("click",event => {
  if (event.target === element) closeModal(element);
 });
});

document.querySelectorAll('input[name="delivery"]').forEach(input => {
 input.addEventListener("change",() => {
  const isDelivery = document.querySelector('input[name="delivery"]:checked').value === "Entrega";
  document.getElementById("addressBox").hidden = !isDelivery;
  document.getElementById("address").required = isDelivery;
 });
});

function getOrderHistory() {
 const history = readStorage(HISTORY_KEY,[]);
 return Array.isArray(history) ? history : [];
}

function saveOrderToHistory(order) {
 const history = getOrderHistory();
 history.unshift(order);
 saveStorage(HISTORY_KEY,history.slice(0,20));
 checkOrderHistoryButton();
}

