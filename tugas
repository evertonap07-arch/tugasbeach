 const id = "custom_" + Date.now() + "_" + Math.floor(Math.random() * 10000);

 const product = {
  id,
  name:"Pastel Personalizado",
  price:23,
  isCustom:true,
  ingredients:ingredients.join(", ")
 };

 customProducts.push(product);
 products.push(product);
