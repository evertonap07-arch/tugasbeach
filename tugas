<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0B0B0B">
<meta name="description" content="Tuga's Beach: pastéis artesanais e bebidas. Monte seu pedido pelo WhatsApp.">
<title>Tuga's Beach | Pastéis & Gelados</title>

<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 44'%3E%3Cpath d='M4 40C4 18 16 5 32 5s28 13 28 35zM32 5v35M4 40h56M18 12l6 14h16l6-14M24 26l-6 14M40 26l6 14M24 26h16' fill='none' stroke='%2300A896' stroke-width='3'/%3E%3C/svg%3E">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,700;1,800&family=Nunito+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">

<style>
:root {
 --agua:#00A896;
 --sol:#FFB347;
 --areia:#E6D7B7;
 --preto:#0B0B0B;
 --texto:#F7F5EB;
 --card:#161614;
 --linha:#30302B;
 --muted:#B9B29D;
 --titulo:'Barlow Condensed',Impact,sans-serif;
 --fonte:'Nunito Sans',Arial,sans-serif;
}

* { box-sizing:border-box; }

html {
 scroll-behavior:smooth;
 scroll-padding-top:145px;
}

body {
 margin:0;
 background:var(--preto);
 color:var(--texto);
 font-family:var(--fonte);
}

body.modal-open { overflow:hidden; }

button,input,textarea,select { font:inherit; }
button { cursor:pointer; }

.wrap {
 width:100%;
 max-width:760px;
 margin:auto;
 padding:0 20px;
}

.hero {
 position:relative;
 overflow:hidden;
 text-align:center;
 padding:36px 0 30px;
 border-bottom:1px solid var(--linha);
 background:
 radial-gradient(ellipse at 50% 0%,#00a89625,transparent 65%),
 var(--preto);
}

.hero::after {
 content:"";
 position:absolute;
 bottom:0;
 left:50%;
 transform:translateX(-50%);
 width:90px;
 height:3px;
 background:var(--agua);
}

.brand-label {
 display:inline-block;
 color:var(--sol);
 font-size:11px;
 font-weight:900;
 letter-spacing:4px;
 text-transform:uppercase;
 margin-bottom:12px;
}

.logo {
 font:italic 800 72px/.78 var(--titulo);
 text-transform:uppercase;
 margin:12px 0 20px;
 letter-spacing:-1px;
}

.logo span {
 display:block;
 color:var(--agua);
 font-size:64px;
 margin:12px 0 0 35px;
}

.shell {
 width:66px;
 height:46px;
 fill:none;
 stroke:var(--agua);
 stroke-width:2.5;
 display:block;
 margin:0 auto 13px;
}

.sub {
 color:var(--areia);
 font:italic 700 17px var(--titulo);
 letter-spacing:5px;
 text-transform:uppercase;
}

.slogan {
 font:italic 700 27px/1.05 var(--titulo);
 color:var(--agua);
 margin:20px 0 9px;
}

.intro {
 font-size:14px;
 color:var(--muted);
 line-height:1.6;
 max-width:410px;
 margin:0 auto;
}

.hero-bottom {
 display:flex;
 justify-content:center;
 gap:9px;
 flex-wrap:wrap;
 margin-top:18px;
}

.hero-tag {
 border:1px solid var(--linha);
 color:var(--areia);
 padding:7px 12px;
 border-radius:3px;
 font-size:11px;
 font-weight:800;
 letter-spacing:1px;
 text-transform:uppercase;
}

.delivery-apps {
 display:flex;
 justify-content:center;
 gap:10px;
 margin-top:18px;
 flex-wrap:wrap;
}

.app-btn {
 display:inline-flex;
 align-items:center;
 gap:6px;
 background:var(--card);
 border:1px solid var(--linha);
 color:var(--texto);
 padding:9px 15px;
 border-radius:20px;
 font-size:11px;
 font-weight:900;
 text-decoration:none;
 text-transform:uppercase;
 transition:.2s;
}

.app-btn:hover { transform:translateY(-2px); }
.app-btn.ifood { border-color:#EA1D2C; color:#FF5360; }
.app-btn.app99 { border-color:#FF8000; color:#FF9B33; }

.sticky-container {
 position:sticky;
 top:0;
 z-index:10;
 background:#0B0B0BF2;
 border-bottom:1px solid var(--linha);
 backdrop-filter:blur(12px);
}

.search-box-wrapper {
 max-width:760px;
 margin:auto;
 padding:10px 20px 0;
}

.search-input {
 width:100%;
 background:var(--card);
 border:1px solid var(--linha);
 border-radius:6px;
 padding:12px 14px;
 color:var(--texto);
 font-size:13px;
 outline:none;
}

.search-input:focus { border-color:var(--agua); }

nav ul {
 display:flex;
 gap:8px;
 overflow-x:auto;
 list-style:none;
 margin:auto;
 padding:10px 20px;
 max-width:760px;
 scrollbar-width:none;
}

nav ul::-webkit-scrollbar { display:none; }

nav a {
 display:flex;
 align-items:center;
 gap:7px;
 white-space:nowrap;
 padding:8px 14px;
 border:1px solid var(--linha);
 border-radius:4px;
 color:var(--texto);
 text-decoration:none;
 font:italic 700 16px var(--titulo);
 text-transform:uppercase;
 transition:.2s;
}

nav a.active {
 background:var(--agua);
 border-color:var(--agua);
 color:#000;
}

nav a:hover { border-color:var(--agua); }

.nav-count {
 font:800 10px var(--fonte);
 opacity:.7;
}

main { padding-bottom:35px; }

.menu-intro { padding:28px 0 7px; }

.menu-eyebrow {
 color:var(--sol);
 font-size:11px;
 font-weight:900;
 letter-spacing:3px;
 text-transform:uppercase;
 margin:0 0 7px;
}

.menu-intro h1 {
 font:italic 800 40px/.95 var(--titulo);
 text-transform:uppercase;
 margin:0;
}

.menu-intro p {
 color:var(--muted);
 font-size:13px;
 margin:9px 0 0;
}

.combo-banner {
 background:var(--card);
 border:1px dashed var(--sol);
 padding:13px 16px;
 border-radius:8px;
 margin-top:15px;
 font-size:13px;
 color:var(--texto);
 text-align:center;
 line-height:1.5;
}

.combo-banner strong { color:var(--sol); }

section {
 padding:28px 0 3px;
 scroll-margin-top:150px;
}

.heading {
 display:flex;
 align-items:center;
 gap:12px;
 margin-bottom:7px;
}

.heading svg {
 width:32px;
 height:28px;
 stroke:var(--sol);
 fill:none;
 stroke-width:2;
 flex-shrink:0;
}

h2 {
 font:italic 800 38px/1 var(--titulo);
 text-transform:uppercase;
 margin:0;
}

.note {
 font-size:13px;
 color:var(--muted);
 margin:0 0 16px;
}

.product {
 display:flex;
 flex-direction:column;
 background:var(--preto);
 border:1px solid var(--linha);
 border-radius:7px;
 padding:16px;
 margin-bottom:11px;
 transition:border-color .2s,transform .2s;
}

.product:hover {
 border-color:#00A89680;
 transform:translateY(-2px);
}

.product-top {
 display:flex;
 align-items:flex-start;
 justify-content:space-between;
 gap:10px;
}

h3 {
 font:italic 800 25px/1.05 var(--titulo);
 margin:0 0 4px;
}

.ingredients {
 font-size:12px;
 color:var(--areia);
 font-style:italic;
 margin:0 0 6px;
}

.desc {
 font-size:13px;
 color:var(--muted);
 margin:0;
 line-height:1.55;
}

.bottom {
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:12px;
 margin-top:12px;
 padding-top:10px;
 border-top:1px solid #ffffff0d;
}

.price {
 font:italic 800 29px var(--titulo);
 color:var(--sol);
 white-space:nowrap;
}

.add {
 display:flex;
 align-items:center;
 justify-content:center;
 gap:7px;
 min-width:125px;
 border:1px solid var(--agua);
 border-radius:4px;
 background:var(--agua);
 color:#000;
 font-size:12px;
 font-weight:900;
 padding:11px 14px;
 transition:.2s;
}

.add:hover { background:#08c5b2; }
.add:active { transform:scale(.97); }

.add-symbol {
 font-size:19px;
 line-height:12px;
}

.custom-builder {
 background:var(--preto);
 border:2px solid var(--agua);
 border-radius:8px;
 padding:18px;
 margin-bottom:20px;
}

.custom-builder h3 {
 color:var(--agua);
 font-size:24px;
 margin-bottom:6px;
}

.ingredients-grid {
 display:grid;
 grid-template-columns:repeat(2,1fr);
 gap:8px;
 margin:12px 0 16px;
}

.ingredients-grid label {
 display:flex;
 align-items:center;
 gap:8px;
 font-size:13px;
 font-weight:600;
 background:var(--card);
 padding:9px 10px;
 border:1px solid var(--linha);
 border-radius:4px;
 cursor:pointer;
 margin:0;
}

.ingredients-grid input {
 width:auto;
 accent-color:var(--agua);
}

.empty-search {
 text-align:center;
 padding:35px 15px;
 color:var(--muted);
 border:1px dashed var(--linha);
 border-radius:7px;
 margin-top:20px;
}

.cartbar {
 position:fixed;
 bottom:14px;
 left:50%;
 transform:translateX(-50%);
 z-index:15;
 width:calc(100% - 28px);
 max-width:620px;
 background:var(--sol);
 color:#000;
 padding:13px 16px;
 border-radius:6px;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:12px;
 box-shadow:0 8px 30px #000b;
 border:1px solid #ffca7c;
}

.cartbar[hidden] { display:none; }

.cart-info span {
 display:block;
 font-size:11px;
 font-weight:800;
}

.cart-info strong {
 display:block;
 font:italic 800 27px var(--titulo);
}

.checkout {
 background:#000;
 color:white;
 border:0;
 border-radius:4px;
 padding:13px 18px;
 font-size:12px;
 font-weight:900;
 text-transform:uppercase;
}

.track-bar {
 position:fixed;
 top:15px;
 right:15px;
 z-index:12;
 background:#1a1a18;
 border:1px solid var(--agua);
 color:var(--texto);
 padding:8px 12px;
 border-radius:20px;
 font-size:11px;
 font-weight:800;
 display:flex;
 align-items:center;
 gap:6px;
 box-shadow:0 4px 12px #0008;
 text-transform:uppercase;
}

.track-bar[hidden] { display:none; }

footer {
 background:var(--areia);
 color:#111;
 text-align:center;
 margin-top:30px;
 padding:35px 0 100px;
}

.footer-shell {
 width:45px;
 height:32px;
 stroke:#111;
 fill:none;
 stroke-width:2.5;
 margin-bottom:10px;
}

footer h2 { font-size:36px; }
footer p { font-size:14px; font-weight:700; line-height:1.5; }
footer strong { display:block; margin:17px 0; font-size:15px; }

.footer-contact {
 display:inline-block;
 background:#111;
 color:var(--areia);
 text-decoration:none;
 font-size:12px;
 font-weight:900;
 padding:12px 20px;
 border-radius:4px;
 margin:5px 0 12px;
}

.footer-links {
 display:flex;
 justify-content:center;
 flex-wrap:wrap;
 gap:18px;
 margin-top:22px;
}

.footer-links button {
 background:none;
 border:0;
 color:#111;
 text-decoration:underline;
 font-weight:800;
 font-size:12px;
 padding:5px;
}

.modal {
 display:none;
 position:fixed;
 inset:0;
 z-index:30;
 background:#000d;
 align-items:center;
 justify-content:center;
 padding:12px;
}

.modal.open { display:flex; }

.panel {
 background:var(--preto);
 border:1px solid var(--linha);
 border-radius:8px;
 width:100%;
 max-width:540px;
 max-height:92vh;
 overflow:auto;
 padding:20px;
}

.panel-head {
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:10px;
 padding-bottom:13px;
 border-bottom:1px solid var(--linha);
 margin-bottom:12px;
}

.panel-head h2 { font-size:32px; }

.close {
 background:#222;
 color:white;
 border:1px solid #444;
 border-radius:4px;
 width:38px;
 height:38px;
 font-size:22px;
 flex-shrink:0;
}

.cartline {
 display:grid;
 grid-template-columns:1fr auto;
 gap:8px;
 padding:13px 0;
 border-bottom:1px solid var(--linha);
}

.cartline strong { font-size:14px; }
.cartline small {
 display:block;
 color:var(--muted);
 margin-top:4px;
 font-size:12px;
}

.qty {
 display:flex;
 align-items:center;
 gap:8px;
}

.qty button {
 width:32px;
 height:32px;
 border:0;
 border-radius:4px;
 background:var(--agua);
 color:#000;
 font-size:18px;
 font-weight:900;
}

.coupon-box {
 display:flex;
 gap:8px;
 margin:12px 0;
}

.coupon-box input {
 text-transform:uppercase;
 min-width:0;
}

.apply-coupon {
 background:var(--agua);
 color:#000;
 border:0;
 font-weight:900;
 padding:0 16px;
 border-radius:4px;
 text-transform:uppercase;
 font-size:12px;
}

.coupon-tag,.discount-tag {
 color:var(--sol);
 font-size:13px;
 font-weight:800;
 display:flex;
 justify-content:space-between;
 gap:10px;
 padding:7px 0;
}

.discount-tag {
 border-bottom:1px dashed var(--linha);
}

.total {
 display:flex;
 justify-content:space-between;
 padding:17px 0;
 font-weight:900;
 font-size:17px;
 gap:10px;
 border-top:1px solid var(--linha);
 border-bottom:1px solid var(--linha);
 margin-top:10px;
}

label {
 display:block;
 font-size:13px;
 font-weight:800;
 margin:13px 0 6px;
}

input,textarea,select {
 width:100%;
 padding:12px;
 background:var(--card);
 color:white;
 border:1px solid #45453d;
 border-radius:4px;
 outline:none;
}

input:focus,textarea:focus,select:focus {
 border-color:var(--agua);
}

textarea { min-height:65px; resize:vertical; }

.radio-row {
 display:flex;
 gap:18px;
 flex-wrap:wrap;
}

.radio-row label {
 display:flex;
 align-items:center;
 gap:7px;
}

.radio-row input { width:auto; }

.send {
 width:100%;
 margin-top:17px;
 padding:15px;
 border:0;
 border-radius:4px;
 background:var(--agua);
 color:#000;
 font-size:13px;
 font-weight:900;
 text-transform:uppercase;
}

.legal-content {
 color:var(--texto);
 font-size:14px;
 line-height:1.7;
}

.legal-content h3 {
 color:var(--agua);
 margin-top:22px;
 font-size:22px;
}

.legal-content p { color:#D1CBBE; }

.order-history-card {
 background:var(--card);
 border:1px solid var(--linha);
 padding:12px;
 border-radius:6px;
 margin-bottom:10px;
 font-size:13px;
}

.order-history-card header {
 display:flex;
 justify-content:space-between;
 gap:10px;
 font-weight:800;
 color:var(--sol);
 margin-bottom:6px;
}

button:focus-visible,a:focus-visible {
 outline:2px solid var(--sol);
 outline-offset:3px;
}

@media(max-width:480px) {
 .wrap { padding:0 15px; }
 .hero { padding:30px 0 26px; }
 .logo { font-size:61px; }
 .logo span { font-size:55px; }
 .slogan { font-size:24px; }
 .menu-intro h1 { font-size:35px; }
 h2 { font-size:34px; }
 .product { padding:14px; }
 h3 { font-size:23px; }
 .price { font-size:27px; }
 .add { min-width:112px; padding:10px; font-size:11px; }
 .panel { padding:15px; }
 .track-bar { top:8px; right:8px; }
}

@media(prefers-reduced-motion:reduce) {
 html { scroll-behavior:auto; }
 * { transition:none !important; }
}
</style>
</head>

<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
 <symbol id="shell" viewBox="0 0 64 44">
  <path d="M4 40C4 18 16 5 32 5s28 13 28 35zM32 5v35M4 40h56M18 12l6 14h16l6-14M24 26l-6 14M40 26l6 14M24 26h16"/>
 </symbol>
</svg>

<button class="track-bar" id="openTrackModal" hidden type="button">
 📦 Meus Pedidos
</button>

<header class="hero">
 <div class="wrap">
  <div class="brand-label">Sabor com identidade</div>

  <div class="logo">
   <svg class="shell" viewBox="0 0 64 44" aria-hidden="true">
    <use href="#shell"></use>
   </svg>
   Tuga's <span>Beach</span>
  </div>

  <div class="sub">Pastéis &amp; Gelados</div>

  <p class="slogan">Um casco de sabor<br>em cada mordida</p>

  <p class="intro">
   Escolha seus favoritos, monte seu combo e peça pelo WhatsApp.
   Seu próximo sabor favorito começa aqui.
  </p>

  <div class="hero-bottom">
   <span class="hero-tag">Cardápio digital</span>
   <span class="hero-tag">Peça pelo WhatsApp</span>
  </div>

  <div class="delivery-apps">
   <a href="https://www.ifood.com.br" target="_blank" class="app-btn ifood" rel="noopener noreferrer">
    🛵 iFood
   </a>
   <a href="https://www.99app.com" target="_blank" class="app-btn app99" rel="noopener noreferrer">
    🟡 99Food
   </a>
  </div>
 </div>
</header>

<div class="sticky-container">
 <div class="search-box-wrapper">
  <input type="search" id="searchInput" class="search-input" placeholder="🔍 Buscar por sabor ou ingrediente..." aria-label="Buscar produtos">
 </div>
 <nav aria-label="Categorias do cardápio">
  <ul id="categories"></ul>
 </nav>
</div>

<main class="wrap" id="menu"></main>

<footer>
 <div class="wrap">
  <svg class="footer-shell" viewBox="0 0 64 44" aria-hidden="true">
   <use href="#shell"></use>
  </svg>

  <h2>Tuga's Beach</h2>
  <p>Seu próximo sabor favorito começa aqui.</p>

  <strong>WhatsApp: (13) 98853-3014</strong>

  <a class="footer-contact" href="https://wa.me/5513988533014" target="_blank" rel="noopener noreferrer">
   FALAR COM A LOJA
  </a>

  <p style="font-size:12px;font-weight:600">
   Consulte a disponibilidade e as condições de entrega diretamente com a loja.
  </p>

  <div class="footer-links">
   <button type="button" data-legal="privacy">Política de Privacidade</button>
   <button type="button" data-legal="terms">Termos e Condições</button>
  </div>

  <p style="font-size:11px;font-weight:400;margin-top:22px">
   Tuga's Beach. Todos os direitos reservados.
  </p>
 </div>
</footer>

<div class="cartbar" id="cartbar" hidden>
 <div class="cart-info">
  <span id="count">0 itens</span>
  <strong id="barTotal">R$ 0,00</strong>
 </div>
 <button class="checkout" id="openCart" type="button">Ver carrinho</button>
</div>

<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="cartTitle">
 <div class="panel">
  <div class="panel-head">
   <h2 id="cartTitle">Seu pedido</h2>
   <button class="close" id="closeCart" type="button" aria-label="Fechar">×</button>
  </div>

  <div id="cartItems"></div>

  <div style="margin-top:15px;border-top:1px solid var(--linha);padding-top:12px">
   <label for="couponInput">Possui cupom de desconto? (1 por pedido)</label>
   <div class="coupon-box">
    <input type="text" id="couponInput" placeholder="Ex.: TUGA2, TUGA5 ou TUGA10">
    <button type="button" class="apply-coupon" id="applyCouponBtn">Aplicar</button>
   </div>
   <p id="couponFeedback" style="font-size:12px;color:var(--muted);margin-top:4px"></p>
  </div>

  <div id="discountBox"></div>
  <div id="couponDisplayBox"></div>

  <div class="total">
   <span>Total final</span>
   <span id="total">R$ 0,00</span>
  </div>

  <form id="orderForm">
   <label for="customer">Seu nome *</label>
   <input id="customer" required maxlength="80" autocomplete="name" placeholder="Como podemos te chamar?">

   <label for="phone">Telefone para contato *</label>
   <input id="phone" type="tel" required maxlength="25" autocomplete="tel" placeholder="DDD + telefone">

   <label>Como vai receber?</label>
   <div class="radio-row">
    <label><input type="radio" name="delivery" value="Entrega" checked> Entrega</label>
    <label><input type="radio" name="delivery" value="Retirada"> Retirada</label>
   </div>

   <div id="addressBox">
    <label for="address">Endereço de entrega *</label>
    <textarea id="address" required maxlength="250" placeholder="Rua, número, bairro e referência"></textarea>
   </div>

   <label for="payment">Forma de pagamento</label>
   <select id="payment">
    <option>Pix (confirmar com a loja)</option>
    <option>Dinheiro na entrega/retirada</option>
    <option>Cartão na entrega/retirada</option>
    <option>Mercado Pago (combinar com a loja)</option>
   </select>

   <label for="notes">Observações (opcional)</label>
   <textarea id="notes" maxlength="300" placeholder="Ex.: Troco para R$ 50, sem cebola, etc."></textarea>

   <button class="send" type="submit">Enviar pedido pelo WhatsApp</button>
  </form>
 </div>
</div>

<div class="modal" id="trackModal" role="dialog" aria-modal="true" aria-labelledby="trackTitle">
 <div class="panel">
  <div class="panel-head">
   <h2 id="trackTitle">Meus Pedidos</h2>
   <button class="close" id="closeTrack" type="button" aria-label="Fechar">×</button>
  </div>
  <div id="trackContent"></div>
 </div>
</div>

<div class="modal" id="privacyModal" role="dialog" aria-modal="true" aria-labelledby="privacyTitle">
 <div class="panel">
  <div class="panel-head">
