  container.textContent = "Nenhum pedido recente encontrado neste aparelho.";
  return;
 }

 container.innerHTML = history.map((order,index) => `
  <div class="order-history-card">
   <header>
    <span>Pedido #${history.length - index}</span>
    <span>${escapeHTML(order.date)}</span>
   </header>
   <p><strong>Cliente:</strong> ${escapeHTML(order.customer)}</p>
   <p><strong>Tipo:</strong> ${escapeHTML(order.delivery)}</p>
   <p><strong>Pagamento:</strong> ${escapeHTML(order.payment)}</p>
   <p style="color:var(--sol)"><strong>Total:</strong> ${money(order.total)}</p>
   <div style="margin-top:8px;font-size:12px;color:var(--muted)">
    <strong>Itens:</strong> ${escapeHTML(order.itemsSummary)}
   </div>
   <p style="font-size:11px;color:var(--muted);margin-bottom:0">
    Pedido registrado neste aparelho. Para confirmar o andamento, fale com a loja.
   </p>
  </div>
 `).join("");
}

document.getElementById("orderForm").addEventListener("submit",event => {
 event.preventDefault();

 const entries = getCartEntries();

 if (!entries.length) {
  alert("Adicione pelo menos um produto ao carrinho.");
  return;
 }

 const customer = document.getElementById("customer").value.trim();
 const phone = document.getElementById("phone").value.trim();
 const delivery = document.querySelector('input[name="delivery"]:checked').value;
 const address = document.getElementById("address").value.trim();
 const payment = document.getElementById("payment").value;
 const notes = document.getElementById("notes").value.trim();

 if (!customer || !phone) {
  alert("Preencha seu nome e telefone.");
  return;
 }

 if (delivery === "Entrega" && !address) {
  alert("Informe o endereço para entrega.");
  return;
 }

 const rawTotal = getRawTotal();
 const comboDiscount = getComboDiscount();
 const couponDiscount = activeCoupon ? activeCoupon.discount : 0;
 const finalTotal = getFinalTotal();

 const lines = entries.map(([id,quantity]) => {
  const product = getProduct(id);
  const details = product.ingredients ? ` (${product.ingredients})` : "";
  return `${quantity}x ${product.name}${details} - ${money(product.price * quantity)}`;
 });

 const message = [
  "Olá, Tuga's Beach! Quero fazer um pedido.",
  "",
  "MEU PEDIDO",
  ...lines,
  "",
  `Subtotal: ${money(rawTotal)}`,
  ...(comboDiscount > 0 ? [`Desconto de combo: -${money(comboDiscount)}`] : []),
  ...(activeCoupon ? [`Cupom ${activeCoupon.code}: -${money(couponDiscount)}`] : []),
  `TOTAL DOS PRODUTOS: ${money(finalTotal)}`,
  "",
  `Nome: ${customer}`,
  `Telefone: ${phone}`,
  `Recebimento: ${delivery}`,
  ...(delivery === "Entrega" ? [`Endereço: ${address}`] : []),
  `Pagamento: ${payment}`,
  ...(notes ? [`Observações: ${notes}`] : []),
  "",
  "Por favor, confirme a disponibilidade, a taxa de entrega e o total final."
 ].join("\n");

 const order = {
  date:new Date().toLocaleDateString("pt-BR") + " " +
   new Date().toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"}),
  customer,
  delivery,
  payment,
  total:finalTotal,
  itemsSummary:entries.map(([id,quantity]) => {
   const product = getProduct(id);
   return `${quantity}x ${product.name}`;
  }).join(", ")
 };

 const whatsappURL = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(message)}`;

 // Mantém o pedido salvo localmente e só limpa o carrinho após preparar a mensagem.
 saveOrderToHistory(order);

 // Abre o WhatsApp na mesma aba para evitar bloqueio de pop-up em celulares.
 window.location.href = whatsappURL;
});

document.querySelectorAll("[data-legal]").forEach(button => {
 button.addEventListener("click",() => {
  const type = button.dataset.legal;
  if (type === "privacy") openModal(privacyModal);
  if (type === "terms") openModal(termsModal);
 });
});

document.querySelectorAll("[data-close-legal]").forEach(button => {
 button.addEventListener("click",() => closeModal(button.closest(".modal")));
});

document.addEventListener("keydown",event => {
 if (event.key === "Escape") {
  document.querySelectorAll(".modal.open").forEach(closeModal);
 }
});

document.getElementById("searchInput").addEventListener("input",event => {
 renderMenu(event.target.value);
});

categoriesElement.addEventListener("click",event => {
 const link = event.target.closest("a");
 if (!link) return;

 categoriesElement.querySelectorAll("a").forEach(item => item.classList.remove("active"));
 link.classList.add("active");
});

if ("IntersectionObserver" in window) {
 const observer = new IntersectionObserver(entries => {
  entries.forEach(entry => {
   if (entry.isIntersecting) {
    categoriesElement.querySelectorAll("a").forEach(link => {
     link.classList.toggle(
      "active",
      link.getAttribute("href") === "#" + entry.target.id
     );
    });
   }
  });
 },{rootMargin:"-25% 0px -65% 0px"});

 function observeSections() {
  observer.disconnect();
  document.querySelectorAll("#menu section").forEach(section => observer.observe(section));
 }

 const originalRenderMenu = renderMenu;
 // A observação é atualizada após cada renderização do cardápio.
 const menuObserver = new MutationObserver(() => observeSections());
 menuObserver.observe(menuElement,{childList:true,subtree:true});
}

renderCategories();
renderMenu();
renderCart();
checkOrderHistoryButton();

// Recupera carrinho antigo e descarta produtos que não existem mais.
Object.keys(cart).forEach(id => {
 if (!getProduct(id)) delete cart[id];
});
saveStorage(CART_KEY,cart);
renderCart();
</script>

</body>
</html>
